# Copy to .env and fill in. .env is gitignored.
# On Colab, use the key icon in the sidebar instead -- the notebooks read
# Colab secrets with the same names, and prompt if a value is missing.

# --- Couchbase Capella --------------------------------------------------
# Cluster -> Connect -> Public Connection String
CB_CONNECTION_STRING=couchbases://cb.xxxxxxxx.cloud.couchbase.com
# Cluster -> Settings -> Database Access (NOT your Capella login)
CB_USERNAME=
CB_PASSWORD=
CB_BUCKET=demos

# --- Model provider (any OpenAI-compatible endpoint) ---------------------
# One of: openai | nanogpt | openrouter | groq | anthropic | ollama | custom
CBNB_LLM_PROVIDER=openai
CBNB_LLM_MODEL=
OPENAI_API_KEY=
# NANOGPT_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# For CBNB_LLM_PROVIDER=custom:
# CBNB_LLM_BASE_URL=
# CBNB_LLM_API_KEY=

# --- Claim review (make review) -----------------------------------------
# Optional. A notebook may deliberately demo a cheap model; judging whether its
# prose still matches its stored outputs is not the job to economise on. Falls
# back to CBNB_LLM_MODEL. Never needed to run a notebook.
# CBNB_REVIEW_MODEL=

# --- Embeddings ---------------------------------------------------------
# local = sentence-transformers on this machine (no key, no cost)
# api   = the /embeddings endpoint of the provider above
CBNB_EMBEDDING_BACKEND=local
# CBNB_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
